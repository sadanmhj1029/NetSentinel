# Copy this file to .env and fill in real values before running.
# Never commit the real .env file.

# ---- Application ----
APP_MODE=demo                 # demo | production
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- Database ----
DATABASE_URL=postgresql+psycopg://netsentinel:netsentinel@db:5432/netsentinel
# When running the backend directly on your host (not via docker compose), use:
# DATABASE_URL=postgresql+psycopg://netsentinel:netsentinel@localhost:5432/netsentinel

POSTGRES_USER=netsentinel
POSTGRES_PASSWORD=netsentinel
POSTGRES_DB=netsentinel

# ---- Redis (reserved for future multi-worker deployments; not required for the demo) ----
REDIS_URL=redis://redis:6379/0

# ---- Monitoring / collector ----
POLL_INTERVAL_SECONDS=2
COLLECTOR_STALE_AFTER_SECONDS=10
# simulated: every device is simulator-driven (default, matches the demo).
# hybrid: devices with monitoring_method="icmp" (set per-device via the
#   Devices page or PATCH /devices/{id}) are really pinged; everything
#   else still falls back to the simulator.
# live: same real ICMP polling for "icmp" devices, but nothing falls back
#   to the simulator -- an unconfigured device just goes stale.
POLLING_MODE=simulated

# ---- Detection thresholds (defaults; also editable at runtime via the Devices page) ----
RULE_CONSECUTIVE_FAILS=3
RULE_CONSECUTIVE_RECOVERIES=3
RULE_PACKET_LOSS_PCT=10
RULE_HIGH_CPU_PCT=90
RULE_HIGH_MEMORY_PCT=90
RULE_HIGH_LATENCY_MS=150

# ---- ML ----
ML_MIN_TRAINING_SAMPLES=200
ML_ANOMALY_CONTAMINATION=0.05

# ---- Notifications (console always-on; webhook + email are real; Telegram is reserved, not built yet) ----
NOTIFY_WEBHOOK_URL=
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=netsentinel@companya.com
SMTP_TO=
SMTP_USE_TLS=true
# Not implemented yet -- setting these does nothing (see docs/ARCHITECTURE.md).
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=

# ---- Demo users (seeded on first startup; change these before any real deployment) ----
DEMO_ADMIN_PASSWORD=admin123
DEMO_OPERATOR_PASSWORD=operator123
DEMO_VIEWER_PASSWORD=viewer123

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
